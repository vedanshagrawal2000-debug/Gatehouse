# ==============================================================================
# GATEHOUSE API (FastAPI) Environment Configuration Template
# Copy this file to .env and configure your values.
# DO NOT COMMIT CREDENTIALS OR REAL API KEYS TO VERSION CONTROL.
# ==============================================================================

# Core Application Settings
APP_NAME="GATEHOUSE Tactical Operations API"
VERSION="4.2.0"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# CORS Settings (comma-separated origins or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Google Gemini API
# Get an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"

# Supabase PostgreSQL
# Get your project credentials from your Supabase dashboard: https://supabase.com/dashboard
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"
DATABASE_URL="postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres"

# Telemetry & Operational Parameters
AIR_GAPPED=True
CLEARANCE_LEVEL="SOVEREIGN-L5"
CLUSTER_REGION="CLUSTER-US-EAST"
