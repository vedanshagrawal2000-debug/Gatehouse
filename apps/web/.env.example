# ==============================================================================
# GATEHOUSE Web (Next.js) Environment Configuration Template
# For Vercel Deployment (Root Directory: apps/web)
# DO NOT COMMIT SECRETS OR REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Backend API Endpoint (Your deployed Render service URL)
NEXT_PUBLIC_API_URL="https://gatehouse-api.onrender.com"

# Optional: Server-side proxy target for Next.js API rewrites
API_URL="https://gatehouse-api.onrender.com"

# Application Environment
NEXT_PUBLIC_APP_ENV="production"
NEXT_PUBLIC_APP_VERSION="4.2.0"
