# ==============================================================================
# GATEHOUSE Production & Development Environment Configuration Template
# DO NOT COMMIT SECRETS OR REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel Deployment -> apps/web)
# ------------------------------------------------------------------------------
# Production URL of your deployed FastAPI backend on Render
NEXT_PUBLIC_API_URL="https://gatehouse-api.onrender.com"
NEXT_PUBLIC_APP_ENV="production"
NEXT_PUBLIC_APP_VERSION="4.2.0"

# Optional: Server-side proxy destination (used by Next.js rewrites)
API_URL="https://gatehouse-api.onrender.com"

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render Deployment -> apps/api)
# ------------------------------------------------------------------------------
# Core Server (Render automatically injects PORT)
PORT=8000
HOST="0.0.0.0"
ENVIRONMENT="production"
DEBUG=false
APP_NAME="GATEHOUSE Tactical Operations API"
VERSION="4.2.0"

# CORS Configuration: URL of your deployed Next.js frontend on Vercel
# Supports comma-separated list or FRONTEND_URL variable
FRONTEND_URL="https://gatehouse-web.vercel.app"
CORS_ORIGINS="https://gatehouse-web.vercel.app,http://localhost:3000,http://127.0.0.1:3000"

# Google Gemini API (Strictly Server-Side - Never expose to Frontend)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-2.5-flash"

# Supabase PostgreSQL (Strictly Server-Side - Never expose to Frontend)
# Project Settings -> API & Database on https://supabase.com/dashboard
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres"

# Telemetry defaults
AIR_GAPPED=false
CLEARANCE_LEVEL="SOVEREIGN-L5"
CLUSTER_REGION="CLUSTER-US-EAST"
